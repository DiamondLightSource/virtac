{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Unit Test",
            "type": "debugpy",
            "request": "launch",
            "justMyCode": false,
            "program": "${file}",
            "purpose": [
                "debug-test"
            ],
            "console": "integratedTerminal",
            "env": {
                // Enable break on exception when debugging tests (see: tests/conftest.py)
                "PYTEST_RAISE": "1",
            },
        },
        {
            "name": "Debugger: Virtac",
            "type": "debugpy",
            "request": "launch",
            "program": "/venv/bin/virtac",
            "console": "integratedTerminal",
            "env": {
                "EPICS_CA_SERVER_PORT": "8064",
                "EPICS_CA_REPEATER_PORT": "8065",
            },
        },
        {
            "name": "Debugger: create_csv",
            "type": "debugpy",
            "request": "launch",
            "program": "/venv/bin/create_csv",
            "args": [
                "--offline",
                "49"
            ],
            "console": "integratedTerminal",
            "env": {
                "EPICS_CA_SERVER_PORT": "8064",
                "EPICS_CA_REPEATER_PORT": "8065",
            },
        },
    ]
}
